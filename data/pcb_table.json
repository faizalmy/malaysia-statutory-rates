  "pcb_method": {
    "description": "Monthly Tax Deduction (MTD/PCB) is calculated using the Computerised Calculation Method as specified by LHDN. The formula considers annualised income, reliefs, and prior months' deductions.",
    "key_points": [
      "PCB = (Estimated annual tax - Previous months' PCB) / Remaining months",
      "Annual income = Current month salary x 12 + annualised allowances",
      "Reliefs are deducted from annual income before tax calculation",
      "EPF deduction capped at RM7,000 per year for PCB calculation",
      "MTD applies to all employees earning above the threshold",
      "Employers must use e-CP39 for PCB submission since March 2019"
    ],
    "reference": "LHDN Specification for Monthly Tax Deduction (MTD) 2026 — Computerised Calculation Method"
  },
  "notes": [
    "Source: LHDN Specification for MTD Calculations 2026",
